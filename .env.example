# Copy to .env and adjust as needed.

# --- Postgres ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis (Celery broker + result backend) ---
REDIS_URL=redis://redis:6379/0

# --- MinIO (S3-compatible object storage) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-uploads
MINIO_SECURE=false
# Endpoint the browser/client uses for presigned URLs (host-reachable).
MINIO_PUBLIC_ENDPOINT=localhost:9000

# --- Models ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# CLIP encodes images and text into a shared space (used for text->image search).
CLIP_MODEL=clip-ViT-B-32
IMAGE_EMBEDDING_DIM=512

# Ollama runs on the host. From inside Docker, reach it via host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Must be a vision-capable model so the LLM can answer questions about images.
LLM_MODEL=gemma4:12b
# Keep the model loaded between requests (avoids slow cold-loads).
OLLAMA_KEEP_ALIVE=30m

# --- Retrieval ---
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# Images fed to the vision LLM per query, and min CLIP score to attach one
# during a global (unscoped) query.
IMAGE_TOP_K=2
IMAGE_SCORE_MIN=0.22

# --- Security / ops ---
# Leave API_KEY empty to disable auth. When set, clients
# must send it in the `X-API-Key` header.
API_KEY=
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO
MAX_UPLOAD_MB=50
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,image/webp
